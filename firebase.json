{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist/hosting",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**/*.apk",
        "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }]
      },
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
